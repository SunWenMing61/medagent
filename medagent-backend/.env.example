# =============================================================================
# MedAgent 后端环境变量配置文件（示例）
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件已加入 .gitignore，不会提交到版本控制中
# =============================================================================

# ==============================
# 数据库配置 —— PostgreSQL（向量搜索引擎，用于文档嵌入的相似性检索）
# ==============================
# 格式：postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://medagent:${POSTGRES_PASSWORD:-your-password-here}@localhost:5432/medagent

# ==============================
# 数据库配置 —— MySQL（关系型数据库，存储用户、知识库、文档、会话、反馈等结构化数据）
# ==============================
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
MYSQL_DATABASE_URL=mysql+pymysql://medagent:${MYSQL_PASSWORD:-your-password-here}@localhost:3306/medagent

# ==============================
# Redis 配置（缓存、任务队列、会话管理）
# ==============================
REDIS_URL=redis://localhost:6379/0

# ==============================
# JWT 身份认证配置
# ==============================
SECRET_KEY=your-secret-key-change-in-production      # JWT 签名密钥（生产环境请务必修改为随机字符串）
JWT_ALGORITHM=HS256                                  # JWT 签名算法（HMAC-SHA256）
ACCESS_TOKEN_EXPIRE_MINUTES=1440                     # 访问令牌过期时间（单位：分钟，1440 = 24 小时）

# ==============================
# 大语言模型（LLM）API 配置 —— 兼容 OpenAI API 格式
# ==============================
LLM_API_KEY=your-llm-api-key-here                    # LLM API 密钥（替换为你实际使用的 API Key）
LLM_API_BASE=https://api.deepseek.com                # LLM API 基础地址（示例使用 DeepSeek，可替换为其他兼容服务）
LLM_MODEL=deepseek-v4-pro                            # 使用的模型名称（根据 API 提供商选择对应模型）

# ==============================
# 向量嵌入 API 配置（用于将文本转为向量，实现语义搜索）
# ==============================
EMBEDDING_API_KEY=your-embedding-api-key-here        # 嵌入 API 密钥
EMBEDDING_API_BASE=https://api.openai.com/v1         # 嵌入 API 基础地址（默认使用 OpenAI）
EMBEDDING_MODEL=text-embedding-3-small               # 嵌入模型名称（OpenAI 的 text-embedding-3-small）

# ==============================
# RAG（检索增强生成）配置
# ==============================
TOP_K=5                          # 检索时返回的最相似文档片段数量
SIMILARITY_THRESHOLD=0.5         # 向量相似度阈值（低于此值的文档片段将被过滤掉）
CHUNK_SIZE=500                   # 文档分块时每块的最大字符数
CHUNK_OVERLAP=100                # 相邻文档块之间的重叠字符数（保证上下文连贯性）

# ==============================
# 文件上传配置
# ==============================
UPLOAD_DIR=./uploads             # 上传文件的本地存储目录
MAX_UPLOAD_SIZE_MB=50            # 单个上传文件的最大体积（单位：MB）

# ==============================
# 网络搜索配置（可选，启用后支持"联网搜索"模式）
# 使用 Serper.dev 兼容 API —— 免费注册获取密钥：https://serper.dev
# ==============================
# SEARCH_API_KEY=your-serper-api-key       # 搜索 API 密钥（取消注释以启用）
# SEARCH_API_BASE=https://google.serper.dev # 搜索 API 基础地址

# ==============================
# 服务器配置
# ==============================
HOST=0.0.0.0                     # 服务器监听地址（0.0.0.0 表示监听所有网络接口）
PORT=8000                        # 服务器监听端口
