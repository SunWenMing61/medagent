# =============================================================================
# MedAgent 后端环境变量配置文件（示例）
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件已加入 .gitignore，不会提交到版本控制中
# =============================================================================

# 本机开发前端允许使用 localhost 或 127.0.0.1 访问。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================
# 数据库配置 —— PostgreSQL（向量搜索引擎，用于文档嵌入的相似性检索）
# ==============================
# 格式：postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://medagent:${POSTGRES_PASSWORD:-your-password-here}@localhost:5432/medagent

# ==============================
# 数据库配置 —— MySQL（关系型数据库，存储用户、知识库、文档、会话、反馈等结构化数据）
# ==============================
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
MYSQL_DATABASE_URL=mysql+pymysql://medagent:${MYSQL_PASSWORD:-your-password-here}@localhost:3306/medagent

# ==============================
# Redis 配置（缓存、任务队列、会话管理）
# ==============================
REDIS_URL=redis://localhost:6379/0

# ==============================
# JWT 身份认证配置
# ==============================
SECRET_KEY=your-secret-key-change-in-production      # JWT 签名密钥（生产环境请务必修改为随机字符串）
JWT_ALGORITHM=HS256                                  # JWT 签名算法（HMAC-SHA256）
ACCESS_TOKEN_EXPIRE_MINUTES=1440                     # 访问令牌过期时间（单位：分钟，1440 = 24 小时）

# ==============================
# 大语言模型（LLM）API 配置 —— 兼容 OpenAI API 格式
# ==============================
LLM_API_KEY=your-llm-api-key-here                    # LLM API 密钥（替换为你实际使用的 API Key）
LLM_API_BASE=https://api.deepseek.com                # LLM API 基础地址（示例使用 DeepSeek，可替换为其他兼容服务）
LLM_MODEL=deepseek-v4-pro                            # 使用的模型名称（根据 API 提供商选择对应模型）
LLM_ANSWER_GENERATION_ENABLED=true                   # 使用模型修复错字、断句并生成通顺回答

# ==============================
# 向量嵌入 API 配置（用于将文本转为向量，实现语义搜索）
# ==============================
EMBEDDING_API_KEY=your-embedding-api-key-here        # 嵌入 API 密钥
EMBEDDING_API_BASE=https://api.openai.com/v1/embeddings # 嵌入 API 完整端点
EMBEDDING_MODEL=text-embedding-3-small               # 嵌入模型名称（OpenAI 的 text-embedding-3-small）
EMBEDDING_DIMENSIONS=1024
EMBEDDING_VERSION=v1

# ==============================
# RAG（检索增强生成）配置
# ==============================
SIMILARITY_THRESHOLD=0.5         # 向量相似度阈值（低于此值的文档片段将被过滤掉）
CHUNK_SIZE=500                   # 文档分块时每块的最大字符数
CHUNK_OVERLAP=100                # 相邻文档块之间的重叠字符数（保证上下文连贯性）

# ==============================
# 文件上传配置
# ==============================
UPLOAD_DIR=./uploads             # 上传文件的本地存储目录
MAX_UPLOAD_SIZE_MB=50            # 非 PDF 文件最大体积（MB）；PDF 上传不限制大小

# ==============================
# 扫描 PDF / OCR 配置
# ==============================
OCR_LANGUAGES=ch_sim,en          # EasyOCR 语言，逗号分隔
OCR_DPI=144                      # PDF 扫描页渲染 DPI
OCR_MIN_NATIVE_TEXT_CHARS=40     # 页面原生文字少于该值时使用 OCR
OCR_MAX_PAGES=500                # 单份 PDF 最多 OCR 页数
OCR_USE_GPU=false                # 有可用 CUDA 时可改为 true
DOCUMENT_PROCESS_TIMEOUT_SECONDS=14400  # 扫描件任务最长 4 小时
TASK_STALE_AFTER_SECONDS=900     # 处理中 15 分钟无进度则标记失败
OUTBOX_DISPATCH_INTERVAL_SECONDS=15 # Redis 恢复后自动重放未派发的上传任务
DOCUMENT_INLINE_FALLBACK_ENABLED=true # 没有独立 RQ Worker 时由 API 自动完成解析和向量化
DOCUMENT_INLINE_MAX_WORKERS=2    # API 本地兜底处理最大并发数
DOCUMENT_AUTO_RECOVERY_ENABLED=true # 自动恢复“解析成功但未向量化”的历史文档
DOCUMENT_PROCESS_MAX_ATTEMPTS=3 # SSL/超时/429/5xx 等瞬时错误最多尝试 3 次，并复用解析结果
DOCUMENT_RETRY_DELAY_SECONDS=5  # 文档级瞬时错误重试基础等待秒数

# ==============================
# 网络搜索配置（可选，启用后支持"联网搜索"模式）
# 使用 Serper.dev 兼容 API —— 免费注册获取密钥：https://serper.dev
# ==============================
# SEARCH_API_KEY=your-serper-api-key       # 搜索 API 密钥（取消注释以启用）
ENABLE_GENERAL_WEB_SEARCH=true            # 通用问答自动并行检索知识库与互联网；无密钥时使用公共后备源
# SEARCH_API_BASE=https://google.serper.dev # 搜索 API 基础地址

# ==============================
# 受控多 Agent 运行时
# ==============================
AGENT_MAX_CALLS=8
TOOL_MAX_CALLS=10
RETRIEVAL_MAX_RETRIES=1
QUERY_REWRITE_MAX_RETRIES=1
SAFETY_MAX_REWRITES=1
AGENT_TOTAL_TIMEOUT_SECONDS=45
AGENT_TOKEN_BUDGET=6000
ENABLE_HUMAN_REVIEW=true
CHECKPOINTER_BACKEND=database
CHECKPOINT_TTL=86400
MEMORY_TTL_DAYS=30
ENABLE_NEW_MEMORY_ARCHITECTURE=true
ENABLE_EVIDENCE_VERIFICATION=true
MEMORY_ENABLED=true
LONG_TERM_MEMORY_ENABLED=true
SESSION_MEMORY_BACKEND=sql
SESSION_MEMORY_TTL_DAYS=30
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=medagent
MONGODB_SESSION_COLLECTION=session_memories
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_REQUIRED=false

# 高频标准答案 Redis 缓存（仅普通问答、新会话、非个体医疗问题）
STANDARD_ANSWER_CACHE_ENABLED=true
STANDARD_ANSWER_CACHE_TTL_SECONDS=21600
STANDARD_ANSWER_CACHE_MAX_QUESTION_CHARS=300
STANDARD_ANSWER_CACHE_LOCK_SECONDS=90
STANDARD_ANSWER_CACHE_WAIT_MS=1500
STANDARD_ANSWER_CACHE_VERSION=standard-answer-v3-direct-general
MEMORY_SUMMARY_TOKEN_LIMIT=800
MEMORY_SUMMARY_CHAR_LIMIT=8000
MEMORY_MAX_ITEMS_PER_AGENT=6
MEMORY_MAX_TOKENS_PER_AGENT=1200
MEMORY_DEFAULT_TTL_DAYS=90
MEMORY_MEDICAL_SENSITIVE_ENABLED=false
MEMORY_ENCRYPTION_KEY=
MEMORY_RECENCY_HALF_LIFE_DAYS=30
MEMORY_WEIGHT_QUERY_OVERLAP=0.35
MEMORY_WEIGHT_TASK=0.25
MEMORY_WEIGHT_IMPORTANCE=0.20
MEMORY_WEIGHT_RECENCY=0.10
MEMORY_WEIGHT_CONFIDENCE=0.10
RETRIEVAL_PARENT_CHILD_ENABLED=true
RETRIEVAL_NEIGHBOR_EXPANSION_ENABLED=true
RETRIEVAL_TIMEOUT_SECONDS=10
RETRIEVAL_EMBEDDING_CACHE_TTL=3600
RETRIEVAL_TRACE_ENABLED=true
HNSW_EF_SEARCH=80
ENABLE_ONLINE_MEDICAL_SEARCH=false
ENABLE_AGENT_TRACING=true
DEFAULT_AGENT_MODEL=gpt-4o-mini
TRIAGE_MODEL=gpt-4o-mini
EVIDENCE_MODEL=gpt-4o-mini
ANSWER_MODEL=gpt-4o-mini
SAFETY_MODEL=gpt-4o-mini

# PDF layout, cleaning and OCR quality gates
PDF_PAGE_CLASSIFICATION_ENABLED=true
PDF_LAYOUT_ANALYSIS_ENABLED=true
PDF_TABLE_EXTRACTION_ENABLED=true
PDF_HEADER_FOOTER_REMOVAL_ENABLED=true
PDF_WATERMARK_REMOVAL_ENABLED=true
PDF_CLEANING_VERSION=medical-clean-v3-structured-vision
PDF_PARSER_VERSION=pymupdf-layout-v4-structured-vision
PDF_VISION_ANALYSIS_ENABLED=true
# 可单独配置；留空时优先复用 EMBEDDING_API_KEY，再复用 LLM_API_KEY
PDF_VISION_API_KEY=
PDF_VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
PDF_VISION_MODEL=qwen3-vl-plus
PDF_VISION_MAX_PAGES=0
PDF_VISION_DPI=160
PDF_VISION_MIN_IMAGE_COVERAGE=0.08
PDF_VISION_MIN_DRAWINGS=12
PDF_VISION_MAX_OUTPUT_TOKENS=1800
PDF_VISION_TIMEOUT_SECONDS=90
DOCUMENT_QUALITY_ASSESSMENT_ENABLED=false
OCR_ENABLED=true
OCR_ENGINE=easyocr
OCR_DPI_DEFAULT=180
OCR_DPI_MAX=300
OCR_MAX_PIXELS=24000000
OCR_QUALITY_GOOD_THRESHOLD=0.85
OCR_QUALITY_MANUAL_REVIEW_THRESHOLD=0.65
CHUNK_TOKEN_SIZE=400
CHUNK_TOKEN_OVERLAP=64
PARENT_CHUNK_TOKEN_SIZE=1000

# Unified tool executor
TOOL_DEFAULT_TIMEOUT=8
TOOL_ENABLE_CIRCUIT_BREAKER=true
TOOL_ENABLE_CACHE=true
TOOL_ENABLE_TRACING=true
TOOL_CIRCUIT_FAILURE_THRESHOLD=3
TOOL_CIRCUIT_RESET_SECONDS=30

# ==============================
# 服务器配置
# ==============================
HOST=0.0.0.0                     # 服务器监听地址（0.0.0.0 表示监听所有网络接口）
PORT=8000                        # 服务器监听端口
