# Database - PostgreSQL (vector search)
DATABASE_URL=postgresql://medagent:${POSTGRES_PASSWORD:-your-password-here}@localhost:5432/medagent

# Database - MySQL (relational data)
MYSQL_DATABASE_URL=mysql+pymysql://medagent:${MYSQL_PASSWORD:-your-password-here}@localhost:3306/medagent

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API (OpenAI compatible)
LLM_API_KEY=your-llm-api-key-here
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# Embedding
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# RAG
TOP_K=5
SIMILARITY_THRESHOLD=0.5
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Web Search (Serper.dev compatible — optional, enables "联网搜索" mode)
# Get a free API key at https://serper.dev
# SEARCH_API_KEY=your-serper-api-key
# SEARCH_API_BASE=https://google.serper.dev

# Server
HOST=0.0.0.0
PORT=8000
