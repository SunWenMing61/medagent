# ===== Python 编译缓存 =====
__pycache__/            # Python 字节码缓存目录
*.py[cod]               # 编译后的 Python 文件（.pyc / .pyo / .pyd）
*$py.class              # Jython 编译的 class 文件
*.so                    # 编译的共享对象文件（C 扩展）

# ===== 环境变量 =====
.env                    # 环境变量配置文件（包含敏感信息，不可提交）

# ===== Python 包构建产物 =====
*.egg-info/             # setuptools 生成的 egg-info 目录
dist/                   # 分发包目录（源码分发包和 wheel 包）
build/                  # 构建中间文件目录
.eggs/                  # egg 依赖缓存目录
*.egg                   # egg 包文件

# ===== Python 虚拟环境 =====
.venv/                  # Python 虚拟环境目录（常见命名）
venv/                   # Python 虚拟环境目录（备选命名）
env/                    # Python 虚拟环境目录（备选命名）

# ===== 运行产出的上传文件 =====
uploads/*               # 上传目录下的所有文件（运行时动态生成）
!uploads/.gitkeep       # 保留 .gitkeep 文件用于占位（确保空目录能被 git 跟踪）

# ===== SQLite 数据库文件（本地开发用） =====
*.db                    # SQLite 数据库文件

# ===== 操作系统文件 =====
.DS_Store               # macOS 资源索引文件
.idea/                  # JetBrains IDE（PyCharm）项目配置目录
.vscode/                # Visual Studio Code 配置目录

# ===== 日志文件 =====
*.log                   # 所有日志文件
